{
  "name": "@chappibunny/repolens",
  "version": "1.16.1",
  "mcpName": "io.github.CHAPIBUNNY/repolens",
  "description": "AI-assisted documentation intelligence system for technical and non-technical audiences",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "repolens": "bin/repolens.js",
    "repolens-mcp": "bin/repolens-mcp.js"
  },
  "files": [
    "app.yml",
    "bin",
    "github-app-manifest.json",
    "src",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "llms-install.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "keywords": [
    "cli",
    "documentation",
    "architecture",
    "github",
    "notion",
    "confluence",
    "markdown",
    "developer-tools",
    "repolens",
    "observability",
    "metrics",
    "team-collaboration",
    "discord",
    "obsidian",
    "ai-documentation",
    "mcp",
    "model-context-protocol",
    "architecture-documentation",
    "documentation-generator",
    "docs-as-code",
    "living-documentation",
    "dependency-graph",
    "codebase-analysis",
    "static-analysis",
    "mcp-server",
    "github-action",
    "vscode",
    "code-documentation",
    "software-architecture",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHAPIBUNNY/repolens.git"
  },
  "homepage": "https://chapibunny.github.io/repolens/",
  "bugs": {
    "url": "https://github.com/CHAPIBUNNY/repolens/issues"
  },
  "author": "Charl van Zyl",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test:notion": "node notion-test.js",
    "docs:publish": "node bin/repolens.js publish",
    "init:test": "node src/cli.js init --target /tmp/repolens-init-test",
    "test": "NODE_ENV=test vitest run --no-watch --reporter=verbose",
    "pack:check": "npm pack",
    "audit:runtime": "node scripts/audit-runtime.js",
    "release:check": "npm test && npm run audit:runtime && npm pack --dry-run",
    "test:install": "./test-install.sh",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "fast-glob": "^3.3.3",
    "js-yaml": "^5.5.0",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@sentry/node": "^11.8.0"
  },
  "devDependencies": {
    "tinyexec": "^1.3.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "yauzl": ">=3.2.1",
    "brace-expansion": ">=5.0.6",
    "@opentelemetry/core": ">=2.8.0"
  }
}
